# Service Configuration
HOST=0.0.0.0
PORT=8080
DEBUG=true
APP_NAME=adp_questa_agentic_service
AGENT_NAME=adp_questa_supervisor

# Model Configurations (Gemini 3.1 & Multimodal Models from zee5 and multimodal engines)
MODEL_NAME=gemini-3.1-flash-lite
SUPERVISOR_MODEL_NAME=gemini-flash-latest
INTENT_MODEL_NAME=gemini-3.1-flash-lite
LIVE_MODEL_NAME=gemini-3.1-flash-live-preview
EMBEDDING_MODEL_NAME=text-multilingual-embedding-002
GEMINI_API_KEY=

# Google Cloud Platform Configurations
GCP_PROJECT_ID=gemini-ai-apigee-security
GOOGLE_CLOUD_QUOTA_PROJECT=gemini-ai-apigee-security
GCP_LOCATION=us-central1
GCS_INGEST_BUCKET=adp-questa-document-ingest-poc

# Cloud Spanner Production Settings
SPANNER_INSTANCE_ID=adp-test-spanner
SPANNER_DATABASE_ID=adp_governed_knowledge
SPANNER_USE_EMULATOR=false

# Document AI Processor Settings (Layout Parser v1.6)
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=

# Cloud Memorystore (Redis) Session Entitlements Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=3600

# Governance & VerifyAI Endpoint
VERIFYAI_ENDPOINT=https://verifyai.adp.internal/api/v1/incidents
